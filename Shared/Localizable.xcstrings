        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tick bokser seg gjennom en økt i korte runder og blir sliten når tiden renner ut. Rolig holder den i garde. Reduser bevegelse og strømsparingsmodus holder den rolig og stille."
          }
        }
      }
