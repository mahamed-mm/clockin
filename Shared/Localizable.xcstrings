    "A day shows its sessions on the ribbon. A subject opens its page." : {
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En dag viser øktene sine på båndet. Et emne åpner sin egen side."
